<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>HappyLulu</AssemblyName>
    <Version>1.5.12</Version>
    <FileVersion>1.5.12.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HappyLulu.Core/HappyLulu.Core.csproj" />
    <EmbeddedResource Include="Resources/HappyLuluIcon.png" LogicalName="HappyLulu.Icon.png" />
  </ItemGroup>
</Project>
